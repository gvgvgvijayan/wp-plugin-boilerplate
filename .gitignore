# Operating System files
.DS_Store
Thumbs.db

# opencode tasks
.opencode/

# IDE/Editor files
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# Logs and debug files
debug.log
*.log

# Local environment and config files
wp-cli.local.yml
.env
.env.local
.env.*.local

# Node.js dependencies
node_modules/
npm-debug.log
yarn-error.log

# Composer dependencies
vendor/

# The third-party/ directory must exist locally (composer classmap scans it),
# but it is normally populated by PHP-Scoper. Track its .gitkeep files so the
# directory persists across clones, while keeping scoped PHP files ignored.
third-party/*
!third-party/.gitkeep
!third-party/**/
!third-party/**/.gitkeep
third-party/**/*.php

# Build and deployment artifacts
build/
dist/
.cache/
*.tar.gz
*.zip

# Testing and CI/CD
phpcs.xml.cache
coverage.xml
.junit.xml
.phpunit.cache/
.phpunit.result.cache
artifacts/
tests/e2e/artifacts/
playwright-report/

# Database backups and temporary files
*.sql
*.sql.gz
*.bak
*.tmp
*.old

# Temporary files created by editors or processes
*.swp
*.swo
.aider*
