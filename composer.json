{
	"name": "vijayan/wp-plugin-boilerplate",
	"description": "Bespoke solution which tightly integrated and required for this site.",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Vijayan"
		}
	],
	"require": {
		"php": ">=8.0",
		"php-di/php-di": "^7.0"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"johnpbloch/wordpress-core": "^6.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "*",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"VG\\Plugin_Boilerplate\\": "includes/"
		},
		"classmap": [
			"third-party/"
		]
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.33"
		}
	},
	"scripts": {
		"prefix-deps": "composer bin scoper install --no-dev && vendor-bin/scoper/vendor/bin/php-scoper add-prefix --force",
		"build": [
			"@prefix-deps",
			"composer install --no-dev --optimize-autoloader"
		],
		"test": "npm run test:unit:php"
	},
	"$schema": "https://getcomposer.org/schema.json"
}
