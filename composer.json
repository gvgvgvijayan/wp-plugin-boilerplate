{
	"name": "vijayan/wp-plugin-boilerplate",
	"description": "Bespoke solution which tightly integrated and required for this site.",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Vijayan"
		}
	],
	"require": {
		"php": ">=8.1",
		"php-di/php-di": "^7.0"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"johnbillion/wp-compat": "^2.0",
		"johnpbloch/wordpress-core": "^6.0",
		"php-stubs/wordpress-tests-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "*",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^9.6",
		"swissspidy/phpstan-no-private": "^1.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "*",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"VG\\Plugin_Boilerplate\\": "includes/"
		},
		"classmap": [
			"third-party/"
		]
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.1"
		}
	},
	"scripts": {
		"prefix-deps": "composer --working-dir=vendor-bin/scoper install --no-dev --no-interaction && vendor-bin/scoper/vendor/humbug/php-scoper/bin/php-scoper add-prefix --force",
		"build": [
			"@prefix-deps",
			"composer install --no-dev --optimize-autoloader"
		],
		"lint:php": "phpcs --standard=phpcs.xml -s --colors --extensions=php",
		"format:php": "phpcbf --standard=phpcs.xml --extensions=php",
		"phpstan": "phpstan analyse --memory-limit=2G",
		"phpstan:baseline": "phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"test": "npm run test:unit:php"
	},
	"$schema": "https://getcomposer.org/schema.json"
}
